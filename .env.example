# Environment variables template for thiepmoi-mekongmeris
# DO NOT commit real secrets or credentials into this file or repository.

# MongoDB Atlas connection string (Secret)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=

# Database name in MongoDB Atlas
MONGODB_DB_NAME=thiepmoi_mekongmeris

# Collection name for RSVPs
MONGODB_COLLECTION=rsvps

# Canonical origin for CORS, Open Graph, and redirects
CANONICAL_ORIGIN=https://thiepmoi.mekongmeris.com

# Event identifier
EVENT_ID=grand-opening-2026

# Optional: Cloudflare Turnstile Secret Key (if bot defense enabled)
TURNSTILE_SECRET_KEY=
